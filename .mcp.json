{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.84",
        "--browser",
        "chromium",
        "--headless",
        "--isolated",
        "--output-dir",
        ".playwright-mcp",
        "--allowed-origins",
        "http://localhost:3000;http://localhost:5000"
      ]
    }
  }
}
